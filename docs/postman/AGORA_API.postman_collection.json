{
  "info": {
    "name": "AGORA API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "CSRF cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/sanctum/csrf-cookie"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 or 200', function () {",
                  "  pm.expect([200,204]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login cert (dev)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/login-cert"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('role_id', String(j.roleId));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": "{{base_url}}/api/logout",
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Parties",
      "item": [
        {
          "name": "List parties",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/parties"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "if (pm.response.json().length) {",
                  "  pm.expect(pm.response.json()[0]).to.have.property('id');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('has dni', () => pm.expect(j).to.have.property('dni'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Set nickname",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": "{{base_url}}/api/nickname",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"postman_test_user\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Votations Admin",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/votations"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": "{{base_url}}/api/votations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Votation\",\n  \"description\": \"Test\",\n  \"startDate\": \"2026-04-01 00:00:00\",\n  \"endDate\": \"2026-12-31 23:59:59\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('votation_id', String(pm.response.json().votation.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Vote Citizen",
      "item": [
        {
          "name": "Active votation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/votation/active"
          }
        },
        {
          "name": "Submit vote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": "{{base_url}}/api/vote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partyId\": 1,\n  \"votationId\": {{votation_id}},\n  \"municipalityId\": 1,\n  \"voteHash\": \"0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
            }
          }
        }
      ]
    }
  ]
}
