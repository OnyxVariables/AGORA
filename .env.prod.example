# Plantilla para la VM del stack AGORA unificado (compose.prod.yml)
#   cp .env.prod.example .env
#   docker compose -f compose.prod.yml --env-file .env up -d --build
#
# Escenario actual: acceso temporal por HTTP, sin auth y con Spring en el mismo compose.

# --- Laravel ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://agorachain.es

# --- MariaDB ---
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=agora_prod
DB_USERNAME=agorauser
DB_PASSWORD=CHANGE_ME_DB_USER
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT

# BESU_RPC_URL / WEB3_PROVIDER_URL — qué IP poner y cómo obtenerla
# El JSON-RPC de Besu lo expone Kubernetes como NodePort 30001 (ver Service en
# besu-kubernetes). Laravel (contenedor backend) debe poder hacer HTTP a ese host:puerto.
#
# Opción A (recomendada dentro de la misma VPC): IP PRIVADA del nodo donde el
# NodePort está escuchando (casi siempre sirve la IP privada del master K3s).
#   Ejemplo: http://172.31.12.34:30001
#   Cómo verla (AWS consola): EC2 → instancia master → "IP privada IPv4".
#   O desde el master: hostname -I | awk '{print $1}'
#
# Opción B: IP ELÁSTICA (pública) asociada al master (o a un balanceador).
#   Ejemplo: http://ec2-xx-xx-xx-xx.compute.amazonaws.com:30001
#   Útil si por políticas de red solo puedes salir a Internet; dentro de VPC,
#   la privada suele ser más simple y no pasa por el NAT público.
#
# NO confundir con la IP privada del *pod*; aquí va una IP de *instancia EC2*
# (master o worker) donde kube-proxy publique el puerto 30001.
#
# Comprueba desde la VM1 (host o docker):
#   curl -s -X POST -H "Content-Type: application/json" \
#     --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
#     http://LA_IP_QUE_ELIGAS:30001
#
BESU_RPC_URL=http://REPLACE_K8S_MASTER_OR_NODE_PRIVATE_OR_ELASTIC_IP:30001
WEB3_PROVIDER_URL=http://REPLACE_K8S_MASTER_OR_NODE_PRIVATE_OR_ELASTIC_IP:30001

# -----------------------------------------------------------------------------
# BLOCKCHAIN_ADMIN_ADDRESS y SIMPLE_VOTING_ADDRESS — cómo se obtienen
# -----------------------------------------------------------------------------
# SIMPLE_VOTING_ADDRESS = dirección del contrato SimpleVoting desplegado EN ESTA
# red Besu (chainId del genesis, ej. 1337 en vuestro repo). No vale la de Hardhat local.
#
# Cómo obtenerla:
#   1) Desplegar el contrato contra el RPC de Besu (misma URL que BESU_RPC_URL)
#      con Hardhat/Foundry u otra herramienta, usando una cuenta con ETH/gas en esa red.
#   2) Al desplegar, la herramienta imprime la dirección del contrato; también puede
#      guardarla en un JSON (en el repo hay blockchain/scripts/deploy-simple.js como
#      referencia para entornos Hardhat; adaptad la red al RPC de Besu).
#
# BLOCKCHAIN_ADMIN_ADDRESS = cuenta Ethereum que Laravel usa para firmar operaciones
# de administración on-chain (la usa BlockchainService → debe tener la clave privada
# correspondiente en vuestro flujo; en la práctica suele ser la cuenta desplegadora
# o una cuenta dedicada importada en el nodo / gestionada por vuestro proceso).
# Si desplegáis vosotros el contrato con una cuenta X, muchas veces X es también
# la admin hasta que migréis roles en el contrato.
#
BLOCKCHAIN_ADMIN_ADDRESS=0xREPLACE_WITH_ADMIN_ACCOUNT_HEX
# Clave privada de la cuenta anterior (misma que key-0 del Secret besu-node-keys si usáis esa cuenta).
# Obligatoria para firmar transacciones en Besu (createVotation, cancel, votos, scheduler).
BESU_PRIVATE_KEY=0xREPLACE_WITH_PRIVATE_KEY_HEX
CHAIN_ID=1337
SIMPLE_VOTING_ADDRESS=0xREPLACE_WITH_CONTRACT_ADDRESS_HEX
# Dónde LEE Laravel el JSON del ABI (no copia desde el host). Por defecto storage/app/SimpleVoting.json.
# En cada arranque del backend, setup.sh copia el ABI compilado en la imagen Docker si el fichero no existe.
# Si el volumen backend_data ya existía sin ABI: pon AGORA_FORCE_ABI_SYNC=true una vez, reinicia backend, luego quítalo.
# SIMPLE_VOTING_ABI_PATH=/var/www/html/storage/app/SimpleVoting.json
# AGORA_FORCE_ABI_SYNC=false

# Si el cliente RPC no coincide (ej. Hardhat), la tarjeta blockchain del monitor marca "degraded".
BLOCKCHAIN_EXPECTED_CLIENT=besu

# --- Sesión / Sanctum (residual; en modo inseguro no se usa para auth) ---
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
# Orígenes “stateful” para la cookie de sesión en /api (debe coincidir con el Host de la petición).
# No incluyas "http://" ni un punto inicial.
SANCTUM_STATEFUL_DOMAINS=agorachain.es,www.agorachain.es

# CORS / orígenes frontend por HTTP mientras no haya TLS.
FRONTEND_ORIGINS=http://agorachain.es,http://www.agorachain.es

# --- Modo inseguro temporal (sin sesiones, Sanctum ni control de roles) ---
# true solo si necesitas abrir toda la app sin autenticación mientras se repara TLS/certificados.
AGORA_INSECURE_MODE=true
# Dejarlos vacíos para que el backend coja el primer admin / citizen de la base de datos.
AGORA_INSECURE_ADMIN_USER_ID=
AGORA_INSECURE_CITIZEN_USER_ID=

# --- Frontend (Vite se construye en la imagen) ---
# No se usa auth.* mientras VITE_DISABLE_AUTH=true.
VITE_AUTH_URL=
# vacío: la SPA usa rutas relativas /api/... y /ws en el mismo origen.
VITE_API_URL=
# true para quitar el login/guards del frontend y usar el modo inseguro temporal.
VITE_DISABLE_AUTH=true
VITE_APP_URL=http://agorachain.es
# Déjalos vacíos para usar el mismo origen/protocolo de la página.
VITE_SPRING_HTTP_URL=
VITE_SPRING_WS_URL=

# -----------------------------------------------------------------------------
# VITE_VOTATIONS_ADMIN_TOKEN — cómo se “saca”
# -----------------------------------------------------------------------------
# Es OPCIONAL. Si lo dejáis vacío, Spring no exige cabecera en /actuator ni /api/admin/*.
# Si ponéis un valor secreto (cadena larga aleatoria que inventáis vosotros), Spring
# exige la cabecera HTTP "X-Admin-Token" con ese mismo valor para esas rutas.
# El frontend Monitor envía ese token si está definido aquí (build-time).
#
# Generar ejemplo (Linux/macOS):  openssl rand -hex 32
# Debe ser EL MISMO valor que VOTATIONS_ADMIN_TOKEN si decides proteger Spring.
#
VITE_VOTATIONS_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Spring unificado dentro del mismo compose
# -----------------------------------------------------------------------------
SPRING_PRIVATE_IP=springboot

# -----------------------------------------------------------------------------
# Monitor /nodos Kubernetes en /monitor
# -----------------------------------------------------------------------------
# Si quieres usar el monitor K8s real, además de KUBERNETES_ENABLED=true necesitas
# montar ./kube/config en el servicio springboot.

VOTATION_DURATION_MINUTES=720
FRONTEND_URL=http://agorachain.es
SPRING_PORT=8081
SPRING_PROFILE=prod
AGORA_DEMO_AUTH=false
VOTATIONS_ADMIN_TOKEN=
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=besu
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://agorachain.es,http://www.agorachain.es