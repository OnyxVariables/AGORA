# Development Environment Configuration
# Core Laravel Settings
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Duración fija (en minutos) de cada votación
# 5 = demos rápidas; 720 = 12 h (produccion)
VOTATION_DURATION_MINUTES=5

# Blockchain Configuration
BESU_RPC_URL=http://hardhat:8545
BLOCKCHAIN_ADMIN_ADDRESS=
SIMPLE_VOTING_ADDRESS=
WEB3_PROVIDER_URL=http://hardhat:8545

# Health check del nodo RPC en /admin/monitor (tarjeta "Blockchain RPC")
BLOCKCHAIN_EXPECTED_CLIENT=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Production Environment Configuration
# SESSION_DOMAIN=.agorachain.es
# SESSION_DOMAIN_AUTH=.auth.agorachain.es

# CORS Configuration for Development
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,localhost:8080

# Cache Configuration
CACHE_STORE=database

# Docker Compose Variables
DB_NAME=
DB_USER_NAME=
DB_USER_PASS=
DB_ROOT_PASS=root

# Frontend Environment Variables
VITE_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_SPRING_WS_URL=ws://localhost:8081/ws
# HTTP base del servicio Spring (actuator, API admin cluster)
VITE_SPRING_HTTP_URL=http://localhost:8081
# Opcional: mismo valor que VOTATIONS_ADMIN_TOKEN en Spring para /actuator y /api/admin/*
VITE_VOTATIONS_ADMIN_TOKEN=

# SPRING BOOT
SPRING_PORT=8081
SPRING_PROFILE=dev
# SPRING_PROFILE=prod

# Kubernetes Monitoring (Besu cluster health)
# Local: disabled (set to false)
# Production: enabled with proper namespace and service account
#
# Estado de la tarjeta "API cluster K8s (REST)" en /admin/monitor:
#   - KUBERNETES_ENABLED=false -> el endpoint REST sigue respondiendo, pero
#     la tarjeta se marca como "degraded" con mensaje "Integración con
#     Kubernetes deshabilitada" (no hay cluster real al que consultar).
#   - KUBERNETES_ENABLED=true con kubeconfig/ServiceAccount válidos -> la
#     tarjeta aparece como "ok" y se rellenan los nodos Besu (activos /
#     caídos / no declarados).
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=besu

# Production Kubernetes Configuration
# KUBERNETES_ENABLED=true
# KUBERNETES_NAMESPACE=besu
# ServiceAccount name from monitor-rbac.yaml: agora-votations-monitor